# TRAVEL ORDER RESOLVER - Environment Variables

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=travel_password

# Model Paths
BASELINE_MODEL_PATH=models/baseline
BERT_MODEL_PATH=models/camembert-finetuned
TOKENIZER_PATH=models/tokenizer

# Data Paths
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
TRAINING_DATA_PATH=data/training
DATASET_PATH=data/datasets

# Training Configuration
BATCH_SIZE=16
LEARNING_RATE=2e-5
NUM_EPOCHS=10
MAX_LENGTH=128
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15

# SNCF Open Data API
SNCF_API_BASE_URL=https://data.sncf.com/api/records/1.0
SNCF_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_PATH=logs

# MLflow 
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=travel-order-resolver

# Speech Recognition

SPEECH_LANGUAGE=fr-FR
SPEECH_API_KEY=  

# Performance Monitoring
ENABLE_PROFILING=false
MAX_MEMORY_MB=4096

# Development
DEBUG=false
RANDOM_SEED=42
